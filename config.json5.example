// CandyBot 配置模板（JSON5 格式：支持 // 与 /* */ 注释、尾逗号）
// 复制为 config.json5 后，至少修改：
//   bot.self_qq、ai_backend.api_key、snowluma.api_key，
//   并把要服务的群号写入 groups 且 enabled 为 true。

{
    "bot": {
        "self_qq": 10000,                 // 机器人自己的 QQ 号
        "listen_host": "127.0.0.1",       // 事件服务监听地址
        "listen_port": 5700,              // 事件服务监听端口
        // "event_secret": "xxx",         // 事件推送签名密钥；注释掉表示不校验签名
        "data_dir": "data",               // 数据目录（记忆等持久化文件）
        "self_nickname": "糖糖",          // 机器人昵称：自发言写回记忆、@/回复占位文本
        "max_event_body_bytes": 1048576,  // 事件上报请求体上限（字节，默认 1MB）；
                                          // 带大图的事件正文超限时调大；改动需重启
        // "log_level": "INFO",           // 默认 INFO；排查问题可改为 DEBUG
    },

    // 白名单：每个 key 是群号。列表为空时，若 groups_default.enabled 为 true 则服务所有群
    "groups": {
        "123456789": {
            "enabled": false,
            // 以下字段不写（或写哨兵值 -1 / ""）时继承 groups_default
            "persona": "",
            "proactivity_threshold": -1,
            "cooldown_seconds": -1,
            "context_size": -1,
            "min_gap_messages": -1,
            "busy_rate_per_min": -1,
        },
    },

    // 群级默认值
    "groups_default": {
        "enabled": true,
        "persona": "你叫糖糖，是一个混迹在QQ群里的真人感群友：热爱编程与二次元，说话口语化、简短，偶尔用颜文字，会调侃但不过火；不确定的事情直接说不知道，绝不编造事实。",
        "proactivity_threshold": 8,       // 兴趣评分达到该值才主动回复（0~10）
        "cooldown_seconds": 600,          // 主动回复后每群冷却秒数
        "context_size": 20,               // 送入模型的每群历史消息条数（不写时同样取 20）
        "min_gap_messages": 3,            // 两次主动回复之间至少间隔的群消息数
        "busy_rate_per_min": 6,           // 群消息超过该频率时视为繁忙、抑制主动回复
    },

    // AI 提供商全局默认：下面 models 条目未写 base_url / api_key 时继承这里
    "ai_backend": {
        "base_url": "https://open.bigmodel.cn/api/paas/v4/",
        "api_key": "<Your API Key>",      // 也可留空并经环境变量 OPENAI_API_KEY 提供
    },

    // 每个角色独立选模型，三者可来自不同提供商。
    // 字符串写法 = 仅模型名，提供商与限额继承 ai_backend（向后兼容旧配置）。
    // 对象写法可按模型覆盖：
    //   base_url / api_key   该模型的 OpenAI 兼容端点与密钥（缺省继承 ai_backend）
    //   context_window       上下文窗口（token），用于约束送入的历史长度
    //   max_output_tokens    该模型单次调用的最大输出 token
    //   tool_use             模型是否支持工具调用（默认 true）。false 时该角色
    //                        走纯文本协议（judge 在正文输出 JSON，reply 用末尾
    //                        <drop_img>/<recall_img> 标记）；运行中若端点报工具
    //                        相关错误或忽略 tools 参数，也会自动降级并记警告日志
    //   forced_tool_choice   是否强制指定工具（tool_choice=required，默认 true）。
    //                        思考（thinking）模式的模型普遍不支持强制指定（如
    //                        qwen3 系列会报 400）：这类模型设为 false，请求改用
    //                        tool_choice="auto"，由提示词引导模型主动调用
    "models": {
        "judge": "glm-4-flash",           // 兴趣评分模型
        // "learning": "glm-4-flash",     // 学习任务模型（每日群印象/表达/黑话学习）；
                                        // 注释掉则继承 judge 的配置
        "reply": {
            "model": "glm-4-flash",
            // "base_url": "https://api.deepseek.com/v1",
            // "api_key": "<Another Provider API Key>",
            // "context_window": 64000,
            // "max_output_tokens": 800,
            // "tool_use": false,          // 模型不支持 function calling 时打开
            // "forced_tool_choice": false, // 思考模式不支持 required 强制指定时打开
        },
        // "vision": "glm-4v-flash",      // 视觉模型；注释掉表示禁用图片理解
        // "embedding": "bge-m3",         // 向量模型（可选）：learning.expression_selection_mode
                                        // 设为 "vector"（表达按语境语义检索）时必配，
                                        // 写法与 judge/reply 一致（字符串或对象）；
                                        // 未配置时该项必须保持 weighted_random，否则启动报错
    },

    "generation": {
        "reply_max_tokens": 500,          // reply 模型未配置 max_output_tokens 时生效
        "temperature": 0.8,
        "max_context_chars": 8000,        // 上下文总字符数上限
        "timeout_seconds": 60,
        "recheck_enabled": true,       // 是否对回复做二次评分（默认 true）
        "recheck_min_score": 5,        // 二次评分低于该值则放弃回复（默认 5）
        "freshness_check_enabled": true, // 发送前新鲜度检查：生成期间被 @/被回复时并入新上下文重生成一次（默认开）
        "observe_band": 2,             // 观望带（分）：终评分落在 [门槛-该值, 门槛) 且未被护栏终止时，延迟后重判一次；0 关闭（默认 2）
        "observe_delay_seconds": 45,   // 观望延迟秒数（默认 45）
        "repetition_guard_enabled": true, // 重复抑制：同一条消息疑似已被自己回复过时，在指令层注入「不要重复刚才发言」的提醒（默认开）
        "emoji_chance": 0.25,             // 随机附加 emoji 的概率（0~1）
        "emoji_max": 2,                   // 单条回复最多 emoji 数
        "max_history_images": 8,      // 历史中最多携带的图片数（默认 8）
        // ---- 各角色采样温度（reply 用上面的 temperature；其余角色此前写死在代码里）----
        "judge_temperature": 0.2,         // 兴趣评分/门槛复核
        "describe_temperature": 0.3,      // describe 模式图片转述
        "assess_temperature": 0.2,        // direct 模式图片入库评估
        "learning_temperature": 0.3,      // 后台学习类调用（印象/表达/黑话）
        // ---- 重试与预算（退避延时逐次 ×2）----
        "generate_max_attempts": 2,       // 生成回复的网络重试总尝试次数（默认 2）
        "generate_retry_base_delay": 2.0, // 生成重试首次退避秒数（默认 2）
        "max_reconsider_per_burst": 2,    // 一轮连发被打断后最多几次「重想」（默认 2；0 关闭）
        // 临时随机回复风格：每条回复独立按 multiple_probability 掷点，命中时从
        // 列表随机抽一条注入指令层（如「用 1-2 个字进行回复」）。默认 0 关闭；
        // 不写列表时使用代码内置的 5 条群聊风格示例。
        // "multiple_probability": 0.15,
        // "multiple_reply_style": ["用 1-2 个字进行回复", "只回一个语气词"],
        // AI 味拦截：回复清洗完成后过一轮正则检测，命中则把被拦截回复与原因
        // 附进指令层重生成一次；重试后仍命中则放行并记 warning。
        // ai_flavor_retries=0 关闭整个环节；ai_flavor_rules=[] 同样关闭。
        // "ai_flavor_retries": 1,
        // "ai_flavor_rules": ["作为(一)?(个|位)?(AI|人工智能|语言模型)", "^\\s*以下是"],
    },

    "multimodal": {
        "mode": "placeholder",            // direct = 发原图给视觉模型；placeholder = 仅占位
        "download_media": true,
        "download_timeout_seconds": 15,   // 单张图片下载超时秒数
        "max_image_bytes": 8388608,       // 图片超过该字节数放弃下载（默认 8MB）
        "max_images_per_message": 4,      // 单条消息至多下载几张图（防刷屏）
    },

    "rate_limit": {
        "global_daily_limit": null,       // 全局每日回复上限；null / 注释掉表示不限制
    },

    // 聊天存储（data/candy.db，SQLite）：文本历史永久保留，原图按保留期回收
    "storage": {
        "image_retention_days": 7,        // 聊天原图保留天数；超期降级为总结/占位符
    },

    // 记忆与学习：每日群印象（中期记忆，注入 L2）、表达学习与黑话学习（后台任务，注入 L4）。
    // 整段可省略（全部走默认值）；所有学习任务在后台 asyncio 任务中执行，失败只记日志跳过本次。
    "learning": {
        "enabled": true,                  // 学习任务总开关
        "impression_enabled": true,       // 每日群印象单项开关
        "impression_days": 3,             // 注入 L2 的最近印象天数
        "impression_max_chars": 300,      // 单日印象字数上限
        "expression_enabled": true,       // 表达学习单项开关
        "expression_batch_size": 10,      // 同群被淘汰消息攒够多少条触发一次学习
        "expression_max_inject": 3,       // 单次回复最多注入的表达条数
        "expression_self_review": true,   // AI 自审过滤低质量表达条目
        "expression_selection_mode": "weighted_random", // 表达选取：weighted_random = 按权重随机（现状默认）；vector = 按当前聊天语境做 embedding 语义检索（需配 models.embedding）
        "expression_vector_top_k": 10,    // vector 模式召回的候选数
        "expression_min_similarity": 0.30, // vector 模式相似度下限：低于视为语境无关、宁缺毋滥（0~1）
        "jargon_enabled": true,           // 黑话学习单项开关
        "jargon_max_entries": 50,         // 每群黑话条目上限，超限淘汰最久未命中
        "jargon_max_inject": 5,           // 单次回复最多注入的命中黑话条数
        "pending_buffer_factor": 3,       // 被淘汰消息缓冲容量 = 批大小 × 该系数，溢出丢最旧
        "impression_text_budget": 6000,   // 每日印象总结送入的聊天文本字符预算
        "jargon_candidates_per_batch": 5, // 每批黑话学习实际做双路推断的候选数上限（每候选至少 3 次调用）
        "jargon_meaning_max_chars": 200,  // 黑话含义入库长度上限（防撑爆 L4）
    },

    // 输出层拟人化后处理：拆条发送、打字延迟、错别字与敷衍兜底、连发被打断后的重想（整段可省略，全部走默认值）
    "response_post_process": {
        "enabled": true,                  // false 时行为与未引入后处理前完全一致（整条单发、零延迟、不触发重想）
        "typing_speed": 1.0,              // 打字延迟全局倍率；0 关闭延迟；须为非负有限数，单条封顶 60 秒
        "max_split": 3,                   // 一次回复最多拆成几条消息
        "max_length": 120,                // 单条超过该字数则不发送原文，改抽敷衍回复（按显示字数：emoji/颜文字算 1 字）
        "keep_strong_punctuation": true,  // 拆条时是否保留句末的 ! ?（含全角 ！ ？）；其余句末标点总是去掉
        "typo_error_rate": 0.05,          // 单字被同音替换的概率
        "typo_tone_error_rate": 0.3,      // 替换时选用错误声调拼音的概率
        "typo_word_replace_rate": 0.2,    // 整词替换为同音词的概率
        "typo_correction_probability": 0.5, // 出现错字后追加「＊正确词」更正消息（引用最后一条正文）的概率
        "typo_polyphone_mode": "word_reading", // 多音字错字策略：word_reading=取词内读音照常替换 / skip=跳过多音字；读音无法确定时两种模式都不替换
        // 打字延迟的单字耗时模型：估算秒数 =（各类耗时×数量）× typing_speed，
        // 单条封顶 max_typing_delay_seconds（默认值即提取前代码写死值）
        "typing_cjk_seconds": 0.3,        // 中文/全角字符每字
        "typing_latin_seconds": 0.15,     // 英文数字等半角字符每字
        "typing_special_seconds": 1.0,    // emoji 序列/颜文字每整块
        "typing_single_multiplier": 3.0,  // 无任何特殊块的单字回复加倍
        "max_typing_delay_seconds": 60,   // 单条打字延迟封顶秒数
        // 敷衍池：随机抽一条代替过长回复
        "lazy_replies": ["呃呃", "不晓得", "懒得说", "不知道", "emm"],
    },

    // 表情包（最小版）：识别收到的表情包类图片存入 data/stickers/，
    // 成功发送文字回复后按概率随机跟发一张。整段可省略（全部走默认值）。
    "stickers": {
        "enabled": true,                  // 总开关（关掉既不收集也不跟发）
        "send_probability": 0.05,         // 每条文字回复后跟发一张的概率（0 关闭跟发）
        "max_count": 64,                  // 全局收藏上限，超限替换最久未使用的
        "max_side_px": 512,               // placeholder 模式「尺寸小」启发式的边长上限（像素）
        "summary_keywords": ["表情包", "梗图", "斗图", "动图", "meme"],
                                          // describe 模式总结文本的命中关键词（忽略大小写）；
                                          // 显式 [] 表示该启发式永不命中
        "send_mode": "base64",            // 跟发时 image 段的图片引用方式：
                                          //   base64 图片字节内嵌进发送请求（默认，跨机可发）
                                          //   http   发本机事件服务的只读外链（需配 http_base_url）
                                          //   file   file:// 本机绝对路径，要求 SnowLuma 与
                                          //          CandyBot 同机或共享磁盘（引入 http/base64
                                          //          之前的行为）
                                          // 现读：改完热重载即对之后的跟发生效
        "http_base_url": "",              // 仅 send_mode=http 用到：CandyBot 事件服务对
                                          // SnowLuma 可达的基址，如 http://192.168.1.20:5700
                                          // （可带反向代理路径前缀，但不能带查询串）。
                                          // 只允许 http/https；内网地址放行——本进程从不请求
                                          // 这个 URL，是 SnowLuma 侧来取图
    },

    // 命令插件：群里 / 开头且命令名命中注册表的消息不走大模型，按 unix
    // 命令风格解析参数后调用插件，返回的消息原样发群；未知 /命令 照常
    // 交给大模型。整段可省略（全部走默认值，即启用 + 扫描 plugins/）。
    // 注册表在启动时构建：新增/修改插件文件需重启机器人生效。
    // 开启时 judge/reply 提示词的 L2 状态层会注入「命令功能」须知，
    // 让模型知道历史里的命令与命令输出不是它亲口说的话。
    "plugins": {
        "enabled": true,                  // 总开关（关掉后 / 消息完全走大模型，热重载即时生效）
        "dir": "plugins",                 // 插件目录（相对工作目录，逐个导入其中的 .py）
        "timeout_seconds": 30,            // 异步 handler 执行超时（秒），超时回「执行超时」
        "include_commands_in_history": true,
                                          // 插件产生的消息（被判定为命令的用户消息 + 机器人对命令
                                          // 的回复）是否送入模型的历史上下文；false 时两者仍照常
                                          // 入库（审计与印象统计可用），只是不出现在 judge/reply 的
                                          // 历史里、不占 context_size 名额（现读，改完即时生效，
                                          // 对已入库的历史命令消息同样生效）
    },

    "snowluma": {
        "endpoint": "http://127.0.0.1:3000/",   // OneBot v11 兼容 HTTP API 基址
        "api_key": "<Your API Key>",            // accessToken，作 Bearer token 鉴权
        "timeout_ms": 30000,
        "allow_private_endpoint": true,   // 允许内网地址（本地部署需为 true）
        "send_max_attempts": 3,           // 发送重试总尝试次数（默认 3）
        "send_retry_delay_seconds": 1.5,  // 发送重试首次退避秒数（逐次 ×2）
    },
}
